{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {"deploymentEnabled": {"*": false, "main": true}},
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {"source": "/gestion", "destination": "/studio.html"},
    {"source": "/studio", "destination": "/studio.html"}
  ],
  "headers": [
    {"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},{"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=()"}]},
    {"source":"/gestion","headers":[{"key":"X-Robots-Tag","value":"noindex, nofollow"}]},
    {"source":"/studio","headers":[{"key":"X-Robots-Tag","value":"noindex, nofollow"}]}
  ]
}
